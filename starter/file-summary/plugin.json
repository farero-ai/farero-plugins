{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "file-summary",
	"version": "0.1.0",
	"description": "Summarize a bundled text fixture with a chosen label.",
	"extensions": {
		"ai.farero": {
			"version": "0.1",
			"config": {
				"heading": { "type": "string", "default": "Example", "maxLength": 80 }
			},
			"commands": {
				"summarize": {
					"description": "Count the fixture's lines and words and show its first lines.",
					"runtime": "node",
					"entry": "./ai.farero/summary.mjs",
					"workspace": "required",
					"platforms": ["darwin", "win32", "linux"],
					"inputs": {
						"label": { "type": "string", "required": true, "maxLength": 80 },
						"maxLines": { "type": "integer", "minimum": 1, "maximum": 10, "default": 2 }
					},
					"argv": [{ "input": "label" }, { "input": "maxLines" }, { "config": "heading" }],
					"limits": { "timeoutMs": 5000, "outputBytes": 8192 },
					"dataDestinations": []
				}
			},
			"skills": { "file-summary": { "requiresCommands": ["summarize"] } }
		}
	}
}
